{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information for Ask IA",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last sign in timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Saved Ask IA chat conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Conversation ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Conversation title"
        },
        "model": {
          "type": "string",
          "maxLength": 50,
          "description": "Selected model ID"
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether conversation is pinned"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in ms"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp in ms"
        }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profile"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "User chat conversations"
    }
  }
}
